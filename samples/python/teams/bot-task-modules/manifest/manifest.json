{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.22/MicrosoftTeams.schema.json",
  "manifestVersion": "1.22",
  "version": "1.0.0",
  "id": "${{AAD_APP_CLIENT_ID}}",
  "developer": {
    "name": "Microsoft, Inc.",
    "websiteUrl": "https://example.com",
    "privacyUrl": "https://example.com/privacy",
    "termsOfUseUrl": "https://example.com/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Task Modules Agent",
    "full": "Task Modules Python Agent"
  },
  "description": {
    "short": "Demonstrates task modules in a Teams agent.",
    "full": "Demonstrates Adaptive Card, custom URL, and multi-step task modules in a Microsoft Teams agent using the Microsoft 365 Agents SDK for Python."
  },
  "accentColor": "#FFFFFF",
  "bots": [
    {
      "botId": "${{AAD_APP_CLIENT_ID}}",
      "scopes": [
        "personal"
      ]
    }
  ],
  "validDomains": [
    "your-agent-domain.example"
  ]
}
