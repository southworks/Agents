# Copy this file to .env. Quote values containing #, for example clientSecret="value#suffix".
# Bot app: channel identity; must match the Azure Bot Microsoft App ID and tenant.
# Use Application (client) ID, Directory (tenant) ID, and the secret VALUE, not its ID.
connections__serviceConnection__settings__clientId=
connections__serviceConnection__settings__clientSecret=
connections__serviceConnection__settings__tenantId=

# OAuth/OBO app: the OAuth client, exposed API resource, and SDK OBO client.
connections__oboConnection__settings__clientId=
connections__oboConnection__settings__clientSecret=
connections__oboConnection__settings__tenantId=

# Channel traffic uses serviceConnection. OBO selects oboConnection by name below.
connectionsMap__0__connection=serviceConnection
connectionsMap__0__serviceUrl=*

# graph is the handler ID used by routes and token calls.
AgentApplication__UserAuthorization__Handlers__graph__Settings__title=Graph Sign In
AgentApplication__UserAuthorization__Handlers__graph__Settings__text=Sign in with Microsoft Graph
# Exact name of the saved OAuth connection on the Azure Bot.
AgentApplication__UserAuthorization__Handlers__graph__Settings__azureBotOAuthConnectionName=OboAutoConnection
# SDK credential connection, not another Azure OAuth connection setting.
AgentApplication__UserAuthorization__Handlers__graph__Settings__oboConnectionName=oboConnection
# Downstream scopes; initial OAuth requests api://<OBO_APP_ID>/defaultScopes instead.
AgentApplication__UserAuthorization__Handlers__graph__Settings__oboScopes=https://graph.microsoft.com/.default

DEBUG=agents:*:error,agents:*:info,agents:*:warn
